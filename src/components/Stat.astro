---
interface Props {
  value: string;
  label: string;
  accent?: boolean;
}
const { value, label, accent = false } = Astro.props;
---

<div class="stat">
  <div class:list={['value', { accent }]}>{value}</div>
  <div class="label">{label}</div>
</div>

<style>
  .stat {
    padding: 40px 24px;
    border-right: 1px solid var(--rule);
  }
  .stat:first-child {
    padding-left: 0;
  }
  .stat:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 56px;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .accent {
    color: var(--red);
  }
  .label {
    font-size: 14px;
    margin-top: 10px;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    /* 2×2: first row gets a bottom rule, second column drops its right rule */
    .stat:nth-child(2) {
      padding-right: 0;
      border-right: 0;
    }
    .stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }
    .stat:nth-child(3) {
      padding-left: 0;
    }
  }
  @media (max-width: 640px) {
    .stat {
      padding: 28px 16px;
    }
    .value {
      font-size: 44px;
    }
  }
</style>
