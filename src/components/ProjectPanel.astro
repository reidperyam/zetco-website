---
// Client to supply a Cali–Jamundí works photograph; drop it in /public and set `photo`.
const photo: string | null = null;
---

<section class="project container" id="projects">
  <div class="photo" role="img" aria-label="Cali–Jamundí corridor works">
    {photo && <img src={photo} alt="" loading="lazy" />}
  </div>
  <div class="panel">
    <span class="kicker">Active project</span>
    <div>
      <h3>Vía Cali–Jamundí corridor widening</h3>
      <p>Program management for a 14 km urban corridor: three municipalities, two concessionaires, one schedule held.</p>
      <a class="all" href="#projects">All projects</a>
    </div>
  </div>
</section>

<style>
  .project {
    padding-top: var(--section);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
  }
  .photo {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #2d2b2b;
    overflow: hidden;
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.2);
  }
  .panel {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--red);
    color: #fff;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .panel .kicker {
    color: #fff;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }
  p {
    font-size: 16px;
    line-height: 1.6;
    margin: 16px 0 0;
    max-width: 40ch;
  }
  .all {
    display: inline-block;
    margin-top: 20px;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 2px solid #fff;
    padding-bottom: 4px;
  }
  .all:hover {
    color: #fff;
    opacity: 0.85;
  }

  @media (max-width: 1024px) {
    .project {
      grid-template-columns: 1fr;
    }
    .panel {
      aspect-ratio: auto;
      gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .panel {
      padding: 28px 24px;
    }
    h3 {
      font-size: 32px;
    }
  }
</style>
