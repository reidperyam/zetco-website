---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#services', label: 'Services' },
  { href: '#projects', label: 'Projects' },
  { href: '#firm', label: 'Firm' },
  { href: '#careers', label: 'Careers' },
];
---

<nav class="nav" aria-label="Primary">
  <a class="plate" href="/" aria-label="Zetco home">
    <img src="/zetco-logo.png" alt="Zetco" width="40" height="36" />
  </a>
  <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-links" data-menu-toggle>Menu</button>
  <div class="links" id="nav-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <ThemeToggle />
  <a class="cta" href="mailto:contacto@zetco.com.co">Contact us</a>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
    padding: 22px var(--gutter);
    position: relative;
    z-index: 1;
  }
  .plate {
    background: #fff;
    padding: 6px 10px;
    border-radius: 2px;
    margin-right: auto;
    display: block;
    line-height: 0;
  }
  .plate img {
    height: 36px;
    width: auto;
    display: block;
  }
  .links {
    display: contents;
  }
  .links a {
    color: #fff;
    text-decoration: none;
    font-size: 15px;
  }
  .links a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cta {
    background: var(--black);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 2px;
    transition: background-color 0.15s;
  }
  .cta:hover {
    background: var(--black-hover);
    color: #fff;
  }
  .menu-btn {
    display: none;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.6);
    color: #fff;
    font: inherit;
    font-size: 13px;
    padding: 6px 10px;
    border-radius: 999px;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .nav {
      gap: 20px;
    }
  }
  @media (max-width: 640px) {
    .nav {
      flex-wrap: wrap;
      gap: 12px;
    }
    .menu-btn {
      display: inline-block;
    }
    .cta {
      display: none;
    }
    .links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: 14px;
      padding-top: 8px;
    }
    .links.open {
      display: flex;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const links = document.getElementById('nav-links');
  if (btn && links) {
    btn.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    links.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        links.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
